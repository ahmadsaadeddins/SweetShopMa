<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SweetShopMa.Utils"
             x:Class="SweetShopMa.Views.LoginPage"
             Title="{local:LocalizedString Key=Login}"
             BackgroundColor="#f5f5f5">

    <VerticalStackLayout 
        Padding="20" 
        Spacing="20" 
        VerticalOptions="Center"
        HorizontalOptions="Center"
        MaximumWidthRequest="400">

        <!-- Language Selector -->
        <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
            <Button Text="{local:LocalizedString Key=LanguageEN}" 
                    x:Name="EnglishButton"
                    BackgroundColor="#32b8c6"
                    TextColor="White"
                    Padding="15,5"
                    CornerRadius="5"
                    FontSize="12"
                    Clicked="OnLanguageButtonClicked"/>
            <Button Text="{local:LocalizedString Key=LanguageAR}" 
                    x:Name="ArabicButton"
                    BackgroundColor="#32b8c6"
                    TextColor="White"
                    Padding="15,5"
                    CornerRadius="5"
                    FontSize="12"
                    Clicked="OnLanguageButtonClicked"/>
        </HorizontalStackLayout>

        <!-- Header -->
        <Label 
            x:Name="AppTitleLabel"
            Text="{local:LocalizedString Key=AppTitle}" 
            FontSize="32" 
            FontAttributes="Bold" 
            TextColor="#32b8c6"
            HorizontalTextAlignment="Center"/>
        <Label 
            x:Name="SecureLoginLabel"
            Text="{local:LocalizedString Key=SecureLogin}" 
            FontSize="18" 
            TextColor="#666"
            HorizontalTextAlignment="Center"/>

        <!-- Username Field -->
        <StackLayout Spacing="8">
            <Label x:Name="UsernameLabel" Text="{local:LocalizedString Key=Username}" FontSize="14" FontAttributes="Bold" TextColor="#333"/>
            <Entry 
                x:Name="UsernameEntry"
                Placeholder="{local:LocalizedString Key=EnterUsername}"
                BackgroundColor="White"
                FontSize="14"
                ReturnType="Next"
                Completed="OnUsernameEntryCompleted"/>
        </StackLayout>

        <!-- Password Field with Lock Icon -->
        <StackLayout Spacing="8">
            <Label x:Name="PasswordLabel" Text="{local:LocalizedString Key=Password}" FontSize="14" FontAttributes="Bold" TextColor="#333"/>
            <Entry 
                x:Name="PasswordEntry"
                IsPassword="True"
                Placeholder="{local:LocalizedString Key=EnterPassword}"
                BackgroundColor="White"
                FontSize="14"
                ReturnType="Go"
                Completed="OnPasswordEntryCompleted"/>
        </StackLayout>

        <!-- Error Message -->
        <Label 
            x:Name="ErrorLabel"
            TextColor="#c00000"
            FontSize="12"
            Padding="10"
            BackgroundColor="#ffe6e6"
            HorizontalTextAlignment="Center"
            IsVisible="False"/>

        <!-- Login Button -->
        <Button 
            x:Name="LoginButton"
            Text="{local:LocalizedString Key=LoginButton}"
            BackgroundColor="#32b8c6"
            TextColor="White"
            Padding="12"
            CornerRadius="8"
            FontSize="16"
            FontAttributes="Bold"
            Clicked="OnLoginClicked"/>

        <!-- Location Selection (vibile after login if multiple locations) -->
        <StackLayout x:Name="LocationSelectionLayout" Spacing="8" IsVisible="False">
            <Label x:Name="SelectLocationLabel" Text="{local:LocalizedString Key=SelectLocationIcon}" FontSize="14" FontAttributes="Bold" TextColor="#333"/>
            <Picker 
                x:Name="LocationPicker"
                Title="{local:LocalizedString Key=SelectLocation}"
                BackgroundColor="White"
                FontSize="14"
                ItemDisplayBinding="{Binding LocationName}"/>
            <Button 
                x:Name="ConfirmLocationButton"
                Text="{local:LocalizedString Key=StartSession}"
                BackgroundColor="#4CAF50"
                TextColor="White"
                Padding="12"
                CornerRadius="8"
                FontSize="16"
                FontAttributes="Bold"
                Clicked="OnConfirmLocationClicked"/>
        </StackLayout>

        <!-- Loading Indicator -->
        <ActivityIndicator 
            x:Name="LoadingIndicator"
            IsRunning="False"
            IsVisible="False"
            Color="#32b8c6"
            Scale="1.5"/>

        

    </VerticalStackLayout>

</ContentPage>
