<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SweetShopMa.ViewModels"
             xmlns:res="clr-namespace:SweetShopMa.Resources"
             xmlns:models="clr-namespace:SweetShopMa.Models"
             x:Class="SweetShopMa.Views.UserLocationsPage"
             Title=""
             BackgroundColor="#f0f9fa">

    <Grid RowDefinitions="Auto, *" Padding="20" ColumnSpacing="20">

        <!-- Navigation + Language Selector -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Button x:Name="BackButton"
                    Text=""
                    BackgroundColor="#f0f4f7"
                    TextColor="#1d7480"
                    Padding="10,6"
                    CornerRadius="6"
                    Clicked="OnBackButtonClicked"
                    HorizontalOptions="Start"/>
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="5">
                <Button Text="EN"
                        BackgroundColor="#1d7480"
                        TextColor="White"
                        Padding="8,5"
                        CornerRadius="4"
                        FontSize="10"
                        Clicked="OnLanguageButtonClicked"/>
                <Button Text="AR"
                        BackgroundColor="#1d7480"
                        TextColor="White"
                        Padding="8,5"
                        CornerRadius="4"
                        FontSize="10"
                        Clicked="OnLanguageButtonClicked"/>
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, 400" ColumnSpacing="20">

        <!-- Assignments List -->
        <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *">
            <Label x:Name="UserLocationAssignmentsLabel" Grid.Row="0" Text="" FontSize="20" FontAttributes="Bold" Margin="0,0,0,20"/>
            
            <VerticalStackLayout Grid.Row="1" Spacing="10" Margin="0,0,0,20">
                <Label x:Name="SelectUserLabel" Text="" FontAttributes="Bold"/>
                <Picker ItemsSource="{Binding Users}" 
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedUser}"/>
            </VerticalStackLayout>

            <CollectionView Grid.Row="2" ItemsSource="{Binding Assignments}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label x:Name="NoLocationsLabel" Text="" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UserLocation">
                        <Frame Margin="0,5" Padding="15" CornerRadius="8" HasShadow="True">
                            <Grid ColumnDefinitions="*, Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                                    <Label Text="{Binding LocationId}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="(Assigned Location)" VerticalOptions="Center" TextColor="Gray"/>
                                    <Frame Padding="5,2" BackgroundColor="#4CAF50" CornerRadius="5" IsVisible="{Binding IsPrimary}">
                                        <Label Text="PRIMARY" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                                    </Frame>
                                </HorizontalStackLayout>
                                
                                <Button Grid.Column="1" Text="Remove"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserLocationsViewModel}}, Path=RemoveAssignmentCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FF5252" HeightRequest="40"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- New Assignment Form -->
        <Frame Grid.Column="1" Padding="20" CornerRadius="10" BackgroundColor="White" HasShadow="True" VerticalOptions="Start">
            <VerticalStackLayout Spacing="15">
                <Label x:Name="AssignNewLocationLabel" Text="" FontSize="20" FontAttributes="Bold" TextColor="#512BD4"/>
                <BoxView HeightRequest="1" Color="#f0f0f0"/>

                <Label x:Name="SelectLocationLabel" Text="" FontAttributes="Bold"/>
                <Picker ItemsSource="{Binding Locations}" 
                        ItemDisplayBinding="{Binding LocationName}"
                        SelectedItem="{Binding SelectedLocation}"/>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding IsPrimary}"/>
                    <Label x:Name="SetAsPrimaryLabel" Text="" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Button x:Name="AssignUserButton" Text=""
                        Command="{Binding AssignCommand}"
                        BackgroundColor="#512BD4"
                        Margin="0,20,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>
            </VerticalStackLayout>
        </Frame>

        <ActivityIndicator Grid.ColumnSpan="2" IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"
                           Color="#512BD4" Scale="2"/>
        </Grid>
    </Grid>
</ContentPage>
